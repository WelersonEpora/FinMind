# App
NODE_ENV=development
APP_PORT=3000

# MariaDB (backend)
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_DATABASE=finmind
MARIADB_USER=finmind
MARIADB_PASSWORD=finmind

# MariaDB (bootstrap do container em docker/compose.dev.yml e compose.prod.yml)
MARIADB_ROOT_PASSWORD=finmind_root

# phpMyAdmin (dev)
PHPMYADMIN_PORT=8080

# Autenticação - gere um valor aleatório forte, nunca reaproveite entre
# ambientes (ex.: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
# A duração da sessão (12h, JWT e cookie) é fixa no código, em
# backend/src/config/env.js - não há variável para configurá-la.

# Foto de avatar - diretório de armazenamento (relativo à raiz do
# backend). Opcional, tem default - só mude se precisar de outro caminho.
# Em produção fica num volume Docker (ver docker/compose.prod.yml), pra
# sobreviver a redeploys.
PHOTO_STORAGE_DIR=storage/photos

# Coleta de dados financeiros (backend/src/collectors/) - opcionais, com
# default, sem chave (a API SGS do Banco Central é pública).
BCB_SGS_TIMEOUT_MS=15000
COLLECTOR_RETRY_TENTATIVAS=3
COLLECTOR_RETRY_DELAY_MS=500
# Camada point-in-time (FRED/LBMA/CFTC/USDA) - baixam o histórico inteiro.
COLLECTOR_SOURCE_TIMEOUT_MS=60000
# USDA NASS QuickStats (Crop Progress do milho) - chave gratuita em
# https://quickstats.nass.usda.gov/api . Sem a chave, esse coletor não é registrado.
NASS_API_KEY=
# FRED API - chave gratuita em https://fred.stlouisfed.org/docs/api/api_key.html .
# Com a chave o coletor do FRED usa a API REST; sem ela cai no CSV público
# (reserva, ADR 0012). Também serve às vintages/ALFRED (ADR 0011).
FRED_API_KEY=
# USDA FAS (PSD Online / WASDE) - chave gratuita do api.data.gov, em
# https://api.data.gov/signup/ (portal: https://apps.fas.usda.gov/opendatawebV2/).
# Nao e a mesma chave do NASS. Enviada no header X-Api-Key em api.fas.usda.gov.
FAS_API_KEY=

# Usuário administrador inicial - usados só pelo seeder
# (npm run db:seed em backend/), nunca lidos pelo servidor em runtime.
# Defina uma senha forte antes de rodar o seed em qualquer ambiente real.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Produção (docker/compose.prod.yml) - conta/imagens publicadas no GHCR
GHCR_OWNER=welersonepora
BACKEND_IMAGE_TAG=latest
# 8083 - a VM Oracle Cloud já usa 8081 para o frontend do AgroMind
FRONTEND_PORT=8083
FRONTEND_IMAGE_TAG=latest
