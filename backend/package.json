{
  "name": "finmind-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend base do FinMind",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "node --test",
    "db:migrate": "sequelize-cli db:migrate --config sequelize.config.js",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config sequelize.config.js",
    "db:seed": "sequelize-cli db:seed:all --config sequelize.config.js",
    "db:seed:undo": "sequelize-cli db:seed:undo:all --config sequelize.config.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.0.0"
  }
}
